# Ollama endpoint. Default is the local install on the standard port.
OLLAMA_HOST=http://127.0.0.1:11435

# Default model for normal chat. Recommended: build the uncensored MoE
# (see Modelfile.qwen3-coder-uncensored) and point this at it.
MODEL=qwen3-coder-uncensored:30b-a3b-q4

# Model the harness auto-routes to when a Solidity audit is detected
# (mentions .sol or solidity-audit keywords). Should support tools+thinking.
AUDIT_MODEL=huihui_ai/gpt-oss-abliterated:20b

# HTTP listen config.
PORT=8787
HOST=127.0.0.1

# How many recent messages to replay each turn (sliding window).
HISTORY_WINDOW=40

# Name the agent will refer to the operator as in its internal prompt.
# Default 'the operator'. Set to your own name for personalization.
OPERATOR_NAME=the operator

# Workspace path. Leave unset to use the default ./workspace folder.
# WORKSPACE=./workspace
